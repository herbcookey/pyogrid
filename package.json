{
  "name": "pyogrid",
  "version": "0.8.0",
  "description": "Fast, dependency-free JavaScript data grid with virtual scrolling, Excel-style editing and paste, IME-friendly input, filters, totals, tree grid, and xlsx export.",
  "keywords": [
    "grid",
    "datagrid",
    "data-grid",
    "table",
    "editable",
    "spreadsheet",
    "excel",
    "virtual-scroll",
    "tree-grid",
    "react",
    "vue",
    "angular",
    "ime",
    "vanilla-js"
  ],
  "author": "Donghyeon Shin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/herbcookey/pyogrid.git"
  },
  "homepage": "https://herbcookey.github.io/pyogrid/",
  "bugs": {
    "url": "https://github.com/herbcookey/pyogrid/issues"
  },
  "type": "module",
  "main": "dist/pyogrid.esm.js",
  "module": "dist/pyogrid.esm.js",
  "types": "dist/types/index.d.ts",
  "unpkg": "dist/pyogrid.min.js",
  "jsdelivr": "dist/pyogrid.min.js",
  "style": "dist/pyogrid.css",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/pyogrid.esm.js",
      "default": "./dist/pyogrid.esm.js"
    },
    "./css": "./dist/pyogrid.css",
    "./min.css": "./dist/pyogrid.min.css",
    "./global": "./dist/pyogrid.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "./dist/pyogrid.js",
    "./dist/pyogrid.min.js"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "types": "tsc -p tsconfig.types.json",
    "test": "node tools/vitest.mjs run",
    "test:unit": "node tools/vitest.mjs run",
    "test:e2e": "node tools/build.mjs && playwright test",
    "test:all": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "demo": "node tools/serve.mjs",
    "version": "node tools/sync-version.mjs && git add src/index.js README.md",
    "prepublishOnly": "node tools/sync-version.mjs --check && npm run typecheck && npm run test:unit && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
