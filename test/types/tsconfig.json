{
  // npm run typecheck:types: 빌드된 dist/types를 패키지 이름(pyogrid)으로 불러와 사용자 코드처럼 검사한다.
  // 먼저 npm run build로 dist/types를 만들어야 한다.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "types": []
  },
  "include": ["./**/*.ts"]
}
